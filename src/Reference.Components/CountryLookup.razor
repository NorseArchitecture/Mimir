@page "/reference/country-lookup"
@inherits AsyncComponentBase
@inject IReferenceService ReferenceService

<PageTitle>Country Lookup</PageTitle>

<h1>Country Lookup</h1>

<p>
	Resolves the full country document by any accepted input form (alpha-2, alpha-3, numeric —
	padded or unpadded — or the baked v5 identifier) over the wire, then looks the same identifier
	up locally from <code>Iso3166.Ids</code> to prove the two land on the identical value.
</p>

<FluentTextInput @bind-Value="_request.CodeInput" Label="Code" Placeholder="US, USA, 840, 40..." />
<FluentButton Appearance="ButtonAppearance.Primary" OnClick="LookupAsync">Look up</FluentButton>

@if (_errorMessage is not null)
{
	<FluentMessageBar Intent="MessageBarIntent.Error">@_errorMessage</FluentMessageBar>
}

@if (_response is not null)
{
	<dl>
		<dt>Alpha-2</dt>
		<dd>@_response.Alpha2</dd>
		<dt>Alpha-3</dt>
		<dd>@_response.Alpha3</dd>
		<dt>Name</dt>
		<dd>@_response.Name</dd>
		<dt>Code</dt>
		<dd>@_response.Code</dd>
		<dt>Classification</dt>
		<dd>@_response.Classification</dd>
		@if (_response.Region is { } region)
		{
			<dt>Ancestry</dt>
			<dd>@Ancestry(region)</dd>
		}
		<dt>Wire Id</dt>
		<dd>@_response.Id</dd>
	</dl>

	@if (_bakedId is { } bakedId)
	{
		<p>
			Client-baked Id: @bakedId
			@if (bakedId == _response.Id)
			{
				<FluentBadge Appearance="BadgeAppearance.Filled">Match</FluentBadge>
			}
			else
			{
				<FluentBadge Appearance="BadgeAppearance.Outline">Mismatch</FluentBadge>
			}
		</p>
	}
}

@code {
	readonly CountryRequest _request = new() { CodeInput = "" };
	string? _errorMessage;
	CountryResponse? _response;
	Guid? _bakedId;

	async Task LookupAsync()
	{
		_errorMessage = null;
		_response = null;
		_bakedId = null;

		// The stamp is the client's own verdict, minted by the buffer's setter on every edit —
		// unproven input never buys a round trip (the same gate RegisterRequestValidator's cascade
		// stands on): a malformed code renders locally and the wire never hears about it.
		if (!_request.Code.TryGetValue(out Success<IsoCountryCode> parsed))
		{
			_errorMessage = $"'{_request.CodeInput}' is not a recognized ISO 3166-1 code.";
			return;
		}

		var outcome = await ReferenceService.GetCountry(_request, CancellationToken);

		if (outcome.TryGetValue(out Failed failed))
		{
			_errorMessage = failed.Problem.Category switch
			{
				ErrorCategory.NotFound => $"'{_request.CodeInput}' parsed, but no seeded country matches it.",
				_ => "The lookup failed."
			};
			return;
		}

		_response = outcome.Match(static response => response, static _ => null!);

		// The stamp already carries the proven code, so the baked check is a straight dictionary
		// read — no re-parse, no second format authority: Iso3166.Ids is Reference.Data.Contracts'
		// own precomputed dataset, browser-safe by charter, and the wire result must land on the
		// identical value. The client never recomputes the identifier itself: Reference.Data.Namespaces
		// (and the DeterministicGuid derivation it feeds) is server/tooling/tests-only law — the
		// browser never computes what the contracts surface already bakes.
		_bakedId = Iso3166.Ids[parsed.Value];
	}

	static string Ancestry(RegionResponse region)
	{
		List<string> names = [region.Name];
		if (region.Subregion is { } subregion)
		{
			names.Add(subregion.Name);
			if (subregion.IntermediateRegion is { } intermediate)
				names.Add(intermediate.Name);
		}
		return string.Join(" → ", names);
	}
}
